# =========================
# Laravel / PHP
# =========================

# Environment (NEVER commit)
.env
.env.*

# Dependencies (NEVER commit)
vendor/
node_modules/

# Laravel runtime storage (NEVER commit)
storage/framework/
storage/logs/
storage/app/public/*
storage/*.key

# Cache (generated)
bootstrap/cache/*
!bootstrap/cache/.gitignore

# Optional: if you generate IDE helper files
/.phpstorm.meta.php
/.idea/
*.swp
*.swo

# =========================
# Public runtime / symlinks
# =========================

# Symlink generated by `php artisan storage:link`
public/storage

# NOTE: We DO commit Vite build output (public/build) => DO NOT ignore it!
# public/build/

# =========================
# Node / Frontend tooling
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# =========================
# Testing / Coverage
# =========================
/coverage/
.phpunit.result.cache

# =========================
# Misc
# =========================
*.log
